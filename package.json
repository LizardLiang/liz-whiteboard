{
  "name": "liz-whiteboard",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite dev --host 0.0.0.0 --port 3000\" \"dotenv -e .env.local -- bun run server.dev.ts\"",
    "dev:server": "dotenv -e .env.local -- bun run server.dev.ts",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:cimd": "E2E_BASE_URL=http://localhost:3099 playwright test --config=playwright.cimd.config.ts",
    "lint": "eslint",
    "format": "prettier",
    "typecheck": "tsc --noEmit",
    "check": "prettier --write . && eslint --fix && bun run typecheck",
    "post-cta-init": "npx create-db@latest",
    "db:seed": "dotenv -e .env.local -- bun seed.ts",
    "docker:build": "docker build -t liz-whiteboard:test .",
    "docker:run": "docker run --rm -p 3000:3000 liz-whiteboard:test",
    "prepare": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-push": "bun run typecheck"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@xyflow/react": "^12.12.1",
    "bcryptjs": "^3.0.3",
    "chevrotain": "^11.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "0.10.0",
    "html-to-image": "^1.11.13",
    "jose": "6.2.3",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.261103-rc",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-config": "^0.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.5",
    "dotenv-cli": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "shadcn": "^3.8.5",
    "simple-git-hooks": "^2.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "web-vitals": "^5.3.0"
  },
  "overrides": {
    "@tanstack/start-plugin-core": "1.171.50",
    "lodash-es": "4.18.1"
  }
}
